# Secrets — Discord webhook URLs and API keys live here. Never commit.
.env

# Recorded audio, transcripts, databases, logs — all runtime data.
media/
data/
logs/

# Rdio Scanner's SQLite database and config.
rdio-data/

# Cached Whisper model weights (several GB).
models/

# Your settings. Each is created by copying the matching .example file, which
# IS tracked. Keeping the live copies out of git means your API key, gain and
# error tuning, talkgroup list, and Discord routes are never touched by a
# `git pull` and never end up pushed to GitHub.
config/discord.json
config/trunk-recorder/config.json
config/trunk-recorder/talkgroups.csv

