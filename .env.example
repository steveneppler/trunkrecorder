# ---------------------------------------------------------------------------
# Copy this file to ".env" and edit it:
#
#     cp .env.example .env
#     nano .env
#
# ".env" is git-ignored, so your Discord webhook URLs stay private.
# Every setting below has a working default — you can start with an empty .env
# and only fill in what you want to change.
# ---------------------------------------------------------------------------


# --- General ---------------------------------------------------------------

# Grand Junction is Mountain time. This controls timestamps in logs and both
# web interfaces.
TZ=America/Denver


# --- Whisper transcription -------------------------------------------------

# Which model to use. Bigger = more accurate but slower.
#   large-v3          best accuracy (default)
#   large-v3-turbo    ~4x faster, slightly less accurate
#   distil-large-v3   ~6x faster, good enough for scanner traffic
#   small             only if you have no GPU
WHISPER_MODEL=large-v3

# cuda = use the GPU. cpu = no GPU (expect this to be very slow with large-v3).
WHISPER_DEVICE=cuda

# IMPORTANT for GTX 10-series (1070/1080) cards:
#
# These are "Pascal" GPUs. They do not have fast float16 math, and the Whisper
# library refuses float16 below a newer GPU generation — it silently falls back
# to float32, which uses twice the memory and runs much slower.
#
# On a GTX 1070, "int8" is the correct and fastest choice. Leave this alone
# unless you upgrade to an RTX card, in which case use "float16".
WHISPER_COMPUTE_TYPE=int8

# How hard Whisper searches for the best transcription. 10 matches the settings
# in the whisperbench repo. Lower (5) is faster with a small accuracy cost.
WHISPER_BEAM_SIZE=10

# Skip calls shorter than this, in seconds. Very short transmissions are almost
# always squelch tails or radio clicks with no speech in them.
MIN_CALL_SECONDS=1.0

# Talkgroups to never transcribe, comma-separated. Leave empty to transcribe
# everything that gets recorded.
SKIP_TALKGROUPS=

# How often to check for newly recorded calls, in seconds.
POLL_INTERVAL_SECONDS=2


# --- Housekeeping ----------------------------------------------------------

# Delete recorded audio and transcripts older than this many days.
#
# Do not remove this. A busy P25 site produces several GB per week, and a full
# disk will take down the whole server. Set to 0 to disable (not recommended).
RETENTION_DAYS=30


# --- Web interface ---------------------------------------------------------

WEB_PORT=8080
RDIO_PORT=3000

# 0.0.0.0 means "reachable from anywhere on your home network", which is
# usually what you want. Change to 127.0.0.1 to allow only the server itself.
#
# Do NOT forward these ports through your router to the internet. There is no
# password on either interface.
WEB_BIND=0.0.0.0
RDIO_BIND=0.0.0.0


# --- Discord ---------------------------------------------------------------

# Posts calls (audio + transcript) into Discord channels.
#
# Nothing is posted until you add routing rules to config/discord.json — see
# docs/06-discord.md. Setting a URL here alone does nothing.
#
# To get a webhook URL: open your Discord server, right-click the channel ->
# Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
#
# Treat these like passwords. Anyone who has one can post to your channel.

DISCORD_ENABLED=false

# The fallback channel, used by any routing rule that does not name its own.
DISCORD_WEBHOOK_URL=

# Add as many as you like and reference them by name in config/discord.json.
DISCORD_WEBHOOK_FIRE=
DISCORD_WEBHOOK_LAW=
DISCORD_WEBHOOK_EMS=
DISCORD_WEBHOOK_ROADS=
